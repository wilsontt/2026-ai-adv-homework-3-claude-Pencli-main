<div id="app">
  <h1 class="font-serif-tc text-[32px] font-bold text-ink mb-8">購物車</h1>

  <div v-if="loading" class="flex justify-center py-16">
    <div class="w-8 h-8 border-4 border-moss border-t-transparent rounded-full animate-spin"></div>
  </div>

  <template v-if="!loading && items.length === 0">
    <%- include('../partials/empty-state', { icon: '🛒', title: '購物車是空的', description: '快去挑選喜歡的花束吧！' }) %>
  </template>

  <template v-if="!loading && items.length > 0">

    <!-- Free Shipping Banner -->
    <div v-if="total < 500" class="bg-paper-deep py-3 px-6 flex items-center justify-center gap-2 mb-8 text-sm">
      <span class="text-ink font-medium">再買 NT$ {{ (500 - total).toLocaleString() }} 即可享免運費</span>
    </div>
    <div v-else class="bg-paper-deep py-3 px-6 flex items-center justify-center gap-2 mb-8 text-sm">
      <span class="text-moss font-medium">已達免運門檻！</span>
    </div>

    <div class="flex flex-col lg:flex-row gap-10">

      <!-- Left: Cart Items -->
      <div class="flex-1 flex flex-col gap-0 divide-y divide-ink-soft/20">
        <div
          v-for="item in items"
          :key="item.id"
          class="flex flex-col sm:flex-row items-center gap-5 py-5"
        >
          <div class="w-[88px] h-[88px] flex-shrink-0 overflow-hidden bg-paper-deep">
            <img
              :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=200'"
              :alt="item.product.name"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="flex-1 w-full">
            <div class="flex justify-between items-start mb-3">
              <h3 class="font-serif-tc font-semibold text-ink text-[16px]">{{ item.product.name }}</h3>
              <button @click="confirmDelete(item.id)" class="text-ink-soft hover:text-stamp transition-colors text-sm ml-4">移除</button>
            </div>
            <div class="flex flex-wrap justify-between items-end gap-4">
              <span class="font-mono-ledger text-ink-soft text-sm">NT$ {{ item.product.price.toLocaleString() }}</span>
              <div class="flex items-center border border-ink-soft">
                <button
                  @click="updateQuantity(item.id, item.quantity - 1)"
                  :disabled="item.quantity <= 1"
                  class="w-8 h-8 flex items-center justify-center disabled:opacity-30 font-mono-ledger text-ink"
                >−</button>
                <span class="w-10 text-center font-mono-ledger text-ink text-sm">{{ item.quantity }}</span>
                <button
                  @click="updateQuantity(item.id, item.quantity + 1)"
                  :disabled="item.quantity >= item.product.stock"
                  class="w-8 h-8 flex items-center justify-center disabled:opacity-30 font-mono-ledger text-ink"
                >+</button>
              </div>
              <span class="font-mono-ledger font-bold text-stamp text-[17px]">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Order Summary -->
      <div class="w-full lg:w-[380px]">
        <div class="bg-paper-deep p-7 lg:sticky lg:top-24 flex flex-col gap-5">
          <h2 class="font-serif-tc font-bold text-ink text-[18px]">訂單摘要</h2>
          <div class="receipt-divider"></div>
          <div class="flex justify-between items-end">
            <span class="font-serif-tc font-semibold text-ink text-base">合計</span>
            <span class="font-mono-ledger font-bold text-stamp text-[24px]">NT$ {{ total.toLocaleString() }}</span>
          </div>
          <button @click="goCheckout" class="stamp-btn w-full">前往結帳</button>
        </div>
      </div>

    </div>
  </template>

  <!-- Delete Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center px-4">
    <div class="absolute inset-0 bg-ink/40" @click="confirmVisible = false"></div>
    <div class="relative bg-paper p-8 text-center w-full max-w-sm">
      <h3 class="font-serif-tc text-xl font-bold text-ink mb-2">確認移除</h3>
      <p class="text-ink-soft text-sm mb-7">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex gap-3 justify-center">
        <button @click="confirmVisible = false" class="px-6 py-2.5 text-sm border border-ink-soft text-ink-soft">取消</button>
        <button @click="handleDelete" class="stamp-btn px-6 py-2.5">確認移除</button>
      </div>
    </div>
  </div>
</div>
