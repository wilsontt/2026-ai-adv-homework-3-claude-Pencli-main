<div id="app">
  <div class="-mx-4 -my-8 min-h-[80vh] bg-paper-deep flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-[440px] flex flex-col items-center gap-6">

      <h1 class="font-serif-tc text-[28px] font-bold text-ink">花漾生活</h1>

      <!-- Tab -->
      <div class="flex">
        <button
          @click="activeTab = 'login'; errors = {}"
          class="px-8 py-2.5 text-sm font-bold transition-colors"
          :class="activeTab === 'login' ? 'bg-stamp text-white' : 'border border-ink-soft text-ink-soft'"
        >
          登入
        </button>
        <button
          @click="activeTab = 'register'; errors = {}"
          class="px-8 py-2.5 text-sm font-bold transition-colors"
          :class="activeTab === 'register' ? 'bg-stamp text-white' : 'border border-ink-soft text-ink-soft'"
        >
          註冊
        </button>
      </div>

      <div class="ticket-card ticket-card--on-deep w-full p-8">

        <!-- Login Form -->
        <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="flex flex-col gap-5">
          <h2 class="font-serif-tc text-[20px] font-bold text-ink">登入</h2>
          <div>
            <label class="block text-sm text-ink-soft mb-2">Email</label>
            <input
              v-model="loginForm.email"
              type="email"
              placeholder="admin@hexschool.com"
              class="w-full px-3.5 py-2.5 border text-sm outline-none text-ink placeholder:text-ink-soft/70"
              :class="errors.email ? 'border-stamp' : 'border-ink-soft'"
            />
            <p v-if="errors.email" class="text-stamp text-xs mt-1">{{ errors.email }}</p>
          </div>
          <div>
            <label class="block text-sm text-ink-soft mb-2">密碼</label>
            <input
              v-model="loginForm.password"
              type="password"
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 border text-sm outline-none text-ink placeholder:text-ink-soft/70"
              :class="errors.password ? 'border-stamp' : 'border-ink-soft'"
            />
            <p v-if="errors.password" class="text-stamp text-xs mt-1">{{ errors.password }}</p>
          </div>
          <p v-if="errors.general" class="text-stamp text-xs text-center">{{ errors.general }}</p>
          <button type="submit" :disabled="submitting" class="stamp-btn w-full mt-1">
            {{ submitting ? '登入中...' : '登入' }}
          </button>
          <p class="text-center text-sm text-ink-soft">
            沒有帳號？
            <button type="button" @click="activeTab = 'register'; errors = {}" class="text-moss font-semibold hover:underline">立即註冊</button>
          </p>
        </form>

        <!-- Register Form -->
        <form v-else @submit.prevent="handleRegister" class="flex flex-col gap-5">
          <h2 class="font-serif-tc text-[20px] font-bold text-ink">註冊</h2>
          <div>
            <label class="block text-sm text-ink-soft mb-2">姓名</label>
            <input
              v-model="registerForm.name"
              type="text"
              placeholder="請輸入您的姓名"
              class="w-full px-3.5 py-2.5 border text-sm outline-none text-ink placeholder:text-ink-soft/70"
              :class="errors.name ? 'border-stamp' : 'border-ink-soft'"
            />
            <p v-if="errors.name" class="text-stamp text-xs mt-1">{{ errors.name }}</p>
          </div>
          <div>
            <label class="block text-sm text-ink-soft mb-2">電子郵件</label>
            <input
              v-model="registerForm.email"
              type="email"
              placeholder="example@floralife.com"
              class="w-full px-3.5 py-2.5 border text-sm outline-none text-ink placeholder:text-ink-soft/70"
              :class="errors.email ? 'border-stamp' : 'border-ink-soft'"
            />
            <p v-if="errors.email" class="text-stamp text-xs mt-1">{{ errors.email }}</p>
          </div>
          <div>
            <label class="block text-sm text-ink-soft mb-2">密碼（至少 6 字元）</label>
            <input
              v-model="registerForm.password"
              type="password"
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 border text-sm outline-none text-ink placeholder:text-ink-soft/70"
              :class="errors.password ? 'border-stamp' : 'border-ink-soft'"
            />
            <p v-if="errors.password" class="text-stamp text-xs mt-1">{{ errors.password }}</p>
          </div>
          <p v-if="errors.general" class="text-stamp text-xs text-center">{{ errors.general }}</p>
          <button type="submit" :disabled="submitting" class="stamp-btn w-full mt-1">
            {{ submitting ? '註冊中...' : '立即註冊' }}
          </button>
          <p class="text-center text-sm text-ink-soft">
            已有帳號？
            <button type="button" @click="activeTab = 'login'; errors = {}" class="text-moss font-semibold hover:underline">返回登入</button>
          </p>
        </form>

      </div>
    </div>
  </div>
</div>
