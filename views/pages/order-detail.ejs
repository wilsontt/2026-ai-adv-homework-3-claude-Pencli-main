<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>">

  <div v-if="loading" class="flex justify-center py-20">
    <div class="w-8 h-8 border-4 border-moss border-t-transparent rounded-full animate-spin"></div>
  </div>

  <template v-else-if="order">

    <h1 class="font-serif-tc text-[30px] font-bold text-ink mb-6">訂單詳情</h1>

    <div class="max-w-3xl flex flex-col gap-5 pb-10">

      <!-- Payment Result Alert -->
      <div
        v-if="paymentResult && paymentMessages[paymentResult]"
        class="p-4 font-medium text-sm text-white"
        :class="paymentMessages[paymentResult].cls"
      >
        {{ paymentMessages[paymentResult].text }}
      </div>

      <!-- Order Info Card -->
      <section class="bg-paper-deep p-6 flex flex-col gap-3">
        <h2 class="font-serif-tc text-[18px] font-bold text-ink">訂單資訊</h2>
        <p class="font-mono-ledger text-ink-soft text-sm">訂單編號：{{ order.order_no }}</p>
        <div>
          <span
            class="status-stamp"
            :class="{
              'text-gold-thread': order.status === 'pending',
              'text-moss': order.status === 'paid',
              'text-stamp': order.status === 'failed'
            }"
          >
            {{ statusMap[order.status]?.label || order.status }}
          </span>
        </div>
      </section>

      <!-- Shipping Info Card -->
      <section class="ticket-card p-6 flex flex-col gap-5">
        <h3 class="font-serif-tc text-[18px] font-bold text-ink">收件資訊</h3>
        <div>
          <label class="block text-sm text-ink-soft mb-2">收件人姓名</label>
          <div class="w-full px-3.5 py-2.5 border border-ink-soft text-sm text-ink">{{ order.recipient_name }}</div>
        </div>
        <div>
          <label class="block text-sm text-ink-soft mb-2">Email</label>
          <div class="w-full px-3.5 py-2.5 border border-ink-soft text-sm text-ink">{{ order.recipient_email }}</div>
        </div>
        <div>
          <label class="block text-sm text-ink-soft mb-2">收件地址</label>
          <div class="w-full px-3.5 py-2.5 border border-ink-soft text-sm text-ink">{{ order.recipient_address }}</div>
        </div>
      </section>

      <!-- Products Card -->
      <section class="bg-paper-deep p-6 flex flex-col gap-4">
        <h3 class="font-serif-tc text-[18px] font-bold text-ink">商品明細</h3>
        <div class="flex flex-col gap-3">
          <div v-for="item in order.items" :key="item.id" class="flex items-center gap-3">
            <span class="flex-1 text-ink text-sm truncate">{{ item.product_name }}</span>
            <span class="font-mono-ledger text-ink-soft text-sm w-10 text-right">x{{ item.quantity }}</span>
            <span class="font-mono-ledger text-ink-soft text-sm w-20 text-right">{{ item.product_price.toLocaleString() }}</span>
            <span class="font-mono-ledger text-ink font-bold text-sm w-20 text-right">{{ (item.product_price * item.quantity).toLocaleString() }}</span>
          </div>
        </div>
        <div class="receipt-divider"></div>
        <div class="flex justify-between items-end">
          <span class="font-serif-tc font-semibold text-ink text-base">合計</span>
          <span class="font-mono-ledger font-bold text-stamp text-[22px]">NT$ {{ order.total_amount.toLocaleString() }}</span>
        </div>
      </section>

      <!-- Payment Card (pending only) -->
      <section v-if="order.status === 'pending'" class="bg-paper-deep p-6 flex flex-col gap-4">
        <h3 class="font-serif-tc text-[18px] font-bold text-ink">付款管理</h3>
        <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
          <button
            @click="handleEcpay"
            :disabled="paying || querying"
            class="stamp-btn"
          >
            {{ paying ? '導向付款頁面中...' : '前往付款' }}
          </button>
          <button
            v-if="paymentResult === 'callback' || paymentResult === null"
            @click="handleQueryPayment"
            :disabled="querying || paying"
            class="text-moss font-semibold text-sm hover:underline disabled:opacity-50"
          >
            {{ querying ? '查詢中...' : '查詢付款結果' }}
          </button>
        </div>
        <p class="text-ink-soft text-xs">若您已完成付款，系統將在 5-10 分鐘內自動更新狀態。</p>

        <details class="text-xs text-ink-soft mt-1">
          <summary class="cursor-pointer hover:text-ink select-none">DEV: 模擬付款</summary>
          <div class="flex gap-3 mt-3">
            <button
              @click="handlePaySuccess"
              :disabled="paying"
              class="border border-ink-soft text-ink-soft px-4 py-1.5 disabled:opacity-50"
            >模擬成功</button>
            <button
              @click="handlePayFail"
              :disabled="paying"
              class="border border-ink-soft text-ink-soft px-4 py-1.5 disabled:opacity-50"
            >模擬失敗</button>
          </div>
        </details>
      </section>

      <!-- Back Link -->
      <div class="flex justify-start">
        <a href="/orders" class="text-ink-soft hover:text-moss transition-colors text-sm font-medium">← 返回我的訂單</a>
      </div>

    </div>
  </template>
</div>
