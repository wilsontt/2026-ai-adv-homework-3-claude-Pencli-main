<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>">

  <div v-if="loading" class="flex justify-center py-20">
    <div class="w-8 h-8 border-4 border-floral-green border-t-transparent rounded-full animate-spin"></div>
  </div>

  <template v-else-if="order">

    <!-- Title -->
    <div class="mb-10">
      <h1 class="font-display text-[36px] font-bold text-floral-text">訂單詳情</h1>
      <div class="h-0.5 w-10 bg-floral-green mt-3 rounded-full"></div>
    </div>

    <!-- Payment Result Alert -->
    <div
      v-if="paymentResult && paymentMessages[paymentResult]"
      class="rounded-lg p-4 mb-6 text-sm font-medium border"
      :class="paymentMessages[paymentResult].cls"
    >
      {{ paymentMessages[paymentResult].text }}
    </div>

    <div class="max-w-3xl flex flex-col gap-5">

      <!-- Order Info Card -->
      <section class="bg-white rounded-lg p-7 border border-floral-border flex justify-between items-start">
        <div class="flex flex-col gap-1.5">
          <h2 class="text-floral-text-muted text-[11px] font-semibold tracking-wider uppercase">訂單編號</h2>
          <p class="text-[20px] font-bold text-floral-text font-mono">{{ order.order_no }}</p>
          <p class="text-floral-text-secondary text-sm">建立日期：{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</p>
        </div>
        <span
          class="px-3 py-1 rounded text-xs font-bold"
          :class="{
            'bg-floral-gold/15 text-floral-gold': order.status === 'pending',
            'bg-floral-green-light text-floral-green': order.status === 'paid',
            'bg-red-100 text-red-500': order.status === 'failed'
          }"
        >
          {{ statusMap[order.status]?.label || order.status }}
        </span>
      </section>

      <!-- Shipping Info Card -->
      <section class="bg-white rounded-lg p-7 border border-floral-border">
        <div class="flex items-center gap-2 mb-5">
          <span class="material-symbols-outlined text-floral-green" style="font-size:18px;">local_shipping</span>
          <h3 class="font-display text-[18px] font-bold text-floral-text">收件資訊</h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <p class="text-floral-text-muted text-xs mb-1">收件人</p>
            <p class="text-floral-text font-medium text-sm">{{ order.recipient_name }}</p>
          </div>
          <div>
            <p class="text-floral-text-muted text-xs mb-1">Email</p>
            <p class="text-floral-text font-medium text-sm">{{ order.recipient_email }}</p>
          </div>
          <div class="md:col-span-2">
            <p class="text-floral-text-muted text-xs mb-1">地址</p>
            <p class="text-floral-text font-medium text-sm">{{ order.recipient_address }}</p>
          </div>
        </div>
      </section>

      <!-- Products Card -->
      <section class="bg-white rounded-lg overflow-hidden border border-floral-border">
        <div class="p-7 pb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-floral-green" style="font-size:18px;">redeem</span>
          <h3 class="font-display text-[18px] font-bold text-floral-text">商品明細</h3>
        </div>
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-floral-bg-alt/60">
              <th class="py-3 px-7 text-left text-xs font-semibold text-floral-text-secondary">商品</th>
              <th class="py-3 px-4 text-center text-xs font-semibold text-floral-text-secondary">單價</th>
              <th class="py-3 px-4 text-center text-xs font-semibold text-floral-text-secondary">數量</th>
              <th class="py-3 px-7 text-right text-xs font-semibold text-floral-text-secondary">小計</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-floral-border">
            <tr v-for="item in order.items" :key="item.id">
              <td class="py-4 px-7">
                <p class="font-medium text-floral-text text-sm">{{ item.product_name }}</p>
              </td>
              <td class="py-4 px-4 text-center text-floral-text-secondary text-sm">NT$ {{ item.product_price.toLocaleString() }}</td>
              <td class="py-4 px-4 text-center text-floral-text-secondary text-sm">{{ item.quantity }}</td>
              <td class="py-4 px-7 text-right font-medium text-floral-text text-sm">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="4" class="py-5 px-7 text-right bg-floral-bg">
                <span class="text-floral-text-secondary text-sm">訂單金額總計</span>
                <p class="font-display text-[24px] font-bold text-floral-green mt-1">NT$ {{ order.total_amount.toLocaleString() }}</p>
              </td>
            </tr>
          </tfoot>
        </table>
      </section>

      <!-- Payment Card (pending only) -->
      <section v-if="order.status === 'pending'" class="bg-white rounded-lg p-7 border border-floral-border">
        <div class="flex items-center gap-2 mb-5">
          <span class="material-symbols-outlined text-floral-green" style="font-size:18px;">payments</span>
          <h3 class="font-display text-[18px] font-bold text-floral-text">付款管理</h3>
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
          <button
            @click="handleEcpay"
            :disabled="paying || querying"
            class="flex-1 bg-floral-green text-white px-8 py-3 rounded font-semibold hover:bg-floral-green-mid transition-colors disabled:opacity-50"
          >
            {{ paying ? '導向付款頁面中...' : '前往付款' }}
          </button>
          <button
            v-if="paymentResult === 'callback' || paymentResult === null"
            @click="handleQueryPayment"
            :disabled="querying || paying"
            class="flex-1 border-2 border-floral-green text-floral-green px-8 py-3 rounded font-semibold hover:bg-floral-green-light transition-colors disabled:opacity-50"
          >
            {{ querying ? '查詢中...' : '查詢付款結果' }}
          </button>
        </div>
        <p class="text-center text-floral-text-muted text-xs mt-4">若您已完成付款，系統將在 5-10 分鐘內自動更新狀態。</p>

        <details class="text-xs text-floral-text-muted mt-5">
          <summary class="cursor-pointer hover:text-floral-text-secondary select-none">DEV: 模擬付款</summary>
          <div class="flex gap-3 mt-3">
            <button
              @click="handlePaySuccess"
              :disabled="paying"
              class="border border-floral-border text-floral-text-secondary px-4 py-1.5 rounded hover:bg-floral-bg transition-colors disabled:opacity-50"
            >模擬成功</button>
            <button
              @click="handlePayFail"
              :disabled="paying"
              class="border border-floral-border text-floral-text-secondary px-4 py-1.5 rounded hover:bg-floral-bg transition-colors disabled:opacity-50"
            >模擬失敗</button>
          </div>
        </details>
      </section>

      <!-- Back Link -->
      <div class="pb-10 flex justify-start">
        <a href="/orders" class="flex items-center gap-2 text-floral-text-secondary hover:text-floral-green transition-colors text-sm font-medium">
          <span class="material-symbols-outlined" style="font-size:16px;">arrow_back</span>
          返回我的訂單
        </a>
      </div>

    </div>
  </template>
</div>
