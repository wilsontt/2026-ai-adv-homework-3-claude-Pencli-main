<div id="app">
  <h1 class="font-serif-tc text-[30px] font-bold text-ink mb-8">結帳</h1>

  <div v-if="loading" class="flex justify-center py-16">
    <div class="w-8 h-8 border-4 border-moss border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else class="flex flex-col lg:flex-row gap-10 items-start">

    <!-- Left: Form -->
    <div class="ticket-card flex-1 w-full p-8 flex flex-col gap-6">
      <h2 class="font-serif-tc text-[20px] font-bold text-ink">收件資訊</h2>

      <div>
        <label class="block text-sm text-ink-soft mb-2">收件人姓名</label>
        <input
          v-model="form.recipientName"
          type="text"
          placeholder="請輸入姓名"
          class="w-full px-3.5 py-2.5 border outline-none text-sm text-ink placeholder:text-ink-soft/70"
          :class="errors.recipientName ? 'border-stamp' : 'border-ink-soft'"
        />
        <p v-if="errors.recipientName" class="text-stamp text-xs mt-1">{{ errors.recipientName }}</p>
      </div>
      <div>
        <label class="block text-sm text-ink-soft mb-2">Email</label>
        <input
          v-model="form.recipientEmail"
          type="email"
          placeholder="example@floralife.com"
          class="w-full px-3.5 py-2.5 border outline-none text-sm text-ink placeholder:text-ink-soft/70"
          :class="errors.recipientEmail ? 'border-stamp' : 'border-ink-soft'"
        />
        <p v-if="errors.recipientEmail" class="text-stamp text-xs mt-1">{{ errors.recipientEmail }}</p>
      </div>
      <div>
        <label class="block text-sm text-ink-soft mb-2">收件地址</label>
        <input
          v-model="form.recipientAddress"
          type="text"
          placeholder="請輸入詳細配送地址"
          class="w-full px-3.5 py-2.5 border outline-none text-sm text-ink placeholder:text-ink-soft/70"
          :class="errors.recipientAddress ? 'border-stamp' : 'border-ink-soft'"
        />
        <p v-if="errors.recipientAddress" class="text-stamp text-xs mt-1">{{ errors.recipientAddress }}</p>
      </div>
    </div>

    <!-- Right: Order Summary -->
    <div class="w-full lg:w-[400px]">
      <div class="bg-paper-deep p-7 lg:sticky lg:top-24 flex flex-col gap-5">
        <div class="flex justify-between items-center">
          <h2 class="font-serif-tc font-bold text-ink text-[18px]">訂單摘要</h2>
          <span class="text-ink-soft text-sm">{{ cartItems.length }} 件商品</span>
        </div>

        <div class="flex flex-col gap-3">
          <div
            v-for="item in cartItems"
            :key="item.id"
            class="flex items-center gap-3"
          >
            <span class="flex-1 text-ink text-sm truncate">{{ item.product.name }}</span>
            <span class="font-mono-ledger text-ink-soft text-sm w-10 text-right">x{{ item.quantity }}</span>
            <span class="font-mono-ledger text-ink font-bold text-sm w-20 text-right">{{ (item.product.price * item.quantity).toLocaleString() }}</span>
          </div>
        </div>

        <div class="receipt-divider"></div>

        <div class="flex justify-between items-end">
          <span class="font-serif-tc font-semibold text-ink text-base">合計</span>
          <span class="font-mono-ledger font-bold text-stamp text-[22px]">NT$ {{ cartTotal.toLocaleString() }}</span>
        </div>

        <button
          @click="submitOrder"
          :disabled="submitting"
          class="stamp-btn w-full"
        >
          {{ submitting ? '處理中...' : '確認送出訂單' }}
        </button>
      </div>
    </div>

  </div>
</div>
