<div id="app">

  <!-- Hero -->
  <section class="flex flex-col md:flex-row gap-0 md:gap-14 py-10 md:py-16">
    <div class="w-full md:w-[55%] aspect-[4/3] md:aspect-auto md:h-[420px] bg-paper-deep border border-ink overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1519378058457-4c29a0a2efac?w=1200&q=85"
        alt="花漾生活"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="w-full md:flex-1 flex flex-col justify-center gap-5 mt-8 md:mt-0">
      <p class="font-mono-ledger text-[12px] tracking-[2px] uppercase text-ink-soft">No.024 · SEASONAL CATALOG · 花漾生活</p>
      <h1 class="font-serif-tc font-bold text-[38px] md:text-[44px] leading-[1.25] text-ink">讓花，裝點生活每一刻</h1>
      <p class="text-ink-soft text-[15px] leading-[1.7] max-w-[440px]">精選當季鮮花，職人手工包裝，每一束都傳遞溫暖與祝福。</p>
      <div class="flex items-center gap-6 flex-wrap">
        <a href="#products" class="stamp-btn">立即選購</a>
        <a href="#products" class="text-moss text-sm font-medium hover:underline">瀏覽目錄 →</a>
      </div>
      <div class="receipt-divider w-full max-w-[440px] mt-2"></div>
      <div class="flex items-center gap-7 flex-wrap text-ink-soft text-xs">
        <span>全台配送</span>
        <span>手工包裝</span>
        <span>滿額免運</span>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-14">
    <h2 class="font-serif-tc text-[28px] font-bold text-ink mb-7">精選推薦</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      <div
        v-for="(product, idx) in products.slice(0, 4)"
        :key="product.id"
        class="tag-card cursor-pointer group"
        @click="goToProduct(product.id)"
      >
        <div class="tag-card__tear"></div>
        <div class="aspect-square overflow-hidden bg-paper">
          <img
            :src="product.image_url || featuredImages[idx % 4]"
            :alt="product.name"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="flex flex-col gap-1.5 p-4">
          <p class="font-mono-ledger text-[11px] tracking-wide text-ink-soft">{{ 'No.' + String(product.id).padStart(3, '0') + ' · 花藝' }}</p>
          <h3 class="font-serif-tc font-semibold text-[16px] text-ink truncate">{{ product.name }}</h3>
          <p class="font-mono-ledger font-bold text-stamp text-[15px]">NT$ {{ product.price.toLocaleString() }}</p>
          <div class="flex items-center justify-between pt-1.5">
            <span class="status-stamp text-[10px] px-2 py-1" :class="product.stock > 0 ? 'text-moss' : 'text-stamp'">{{ product.stock > 0 ? '現貨' : '售完' }}</span>
            <button
              @click.stop="addToCart(product)"
              :disabled="product._adding || product.stock <= 0"
              class="stamp-btn py-1.5 px-3 text-[11px]"
            >
              {{ product.stock <= 0 ? '已售完' : (product._adding ? '加入中' : '+ 加入購物車') }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- All Products -->
  <section id="products" class="py-14">
    <div class="flex flex-col items-center text-center gap-2 mb-10">
      <h2 class="font-serif-tc text-[28px] font-bold text-ink">探索所有花藝</h2>
      <p class="text-ink-soft text-[14px]">找到屬於您的那束花</p>
    </div>

    <div v-if="loading" class="flex justify-center py-16">
      <div class="w-8 h-8 border-4 border-moss border-t-transparent rounded-full animate-spin"></div>
    </div>

    <template v-else>
      <div v-if="products.length === 0" class="text-center py-16">
        <p class="text-ink-soft mb-1 font-medium">目前沒有商品</p>
        <p class="text-ink-soft text-sm">請稍後再來看看</p>
      </div>
      <div v-else class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div
          v-for="product in products"
          :key="product.id"
          @click="goToProduct(product.id)"
          class="tag-card cursor-pointer group"
        >
          <div class="tag-card__tear"></div>
          <div class="aspect-square overflow-hidden bg-paper">
            <img
              :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=400'"
              :alt="product.name"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
          </div>
          <div class="flex flex-col gap-1.5 p-4">
            <p class="font-mono-ledger text-[11px] tracking-wide text-ink-soft">{{ 'No.' + String(product.id).padStart(3, '0') + ' · 花藝' }}</p>
            <h3 class="font-serif-tc font-semibold text-[16px] text-ink truncate">{{ product.name }}</h3>
            <p class="font-mono-ledger font-bold text-stamp text-[15px]">NT$ {{ product.price.toLocaleString() }}</p>
            <div class="flex items-center justify-between pt-1.5">
              <span class="status-stamp text-[10px] px-2 py-1" :class="product.stock > 0 ? 'text-moss' : 'text-stamp'">{{ product.stock > 0 ? '現貨' : '售完' }}</span>
              <button
                @click.stop="addToCart(product)"
                :disabled="product._adding || product.stock <= 0"
                class="stamp-btn py-1.5 px-3 text-[11px]"
              >
                {{ product.stock <= 0 ? '已售完' : (product._adding ? '加入中' : '+ 加入購物車') }}
              </button>
            </div>
          </div>
        </div>
      </div>

      <div v-if="pagination.totalPages > 1" class="flex justify-center gap-2 mt-10">
        <button
          v-for="p in pagination.totalPages"
          :key="p"
          @click="loadProducts(p)"
          class="w-9 h-9 font-mono-ledger text-sm font-medium transition-colors"
          :class="p === pagination.page ? 'bg-stamp text-white' : 'bg-paper-deep text-ink hover:opacity-80'"
        >
          {{ p }}
        </button>
      </div>
    </template>
  </section>

  <!-- Reviews -->
  <section class="-mx-4 bg-ink py-16 px-6 md:px-16">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-serif-tc text-[26px] font-bold text-paper text-center mb-10">顧客花束好評分享</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border border-paper-deep/40 p-7 flex flex-col gap-4">
          <div class="text-gold-thread text-sm">★★★★★</div>
          <p class="text-paper-deep text-[13px] leading-[1.8] flex-1">包裝非常精美，花材也很新鮮！送給媽媽的母親節禮物，她非常喜歡。</p>
          <p class="font-mono-ledger text-paper text-xs">— 王小美</p>
        </div>
        <div class="border border-paper-deep/40 p-7 flex flex-col gap-4">
          <div class="text-gold-thread text-sm">★★★★★</div>
          <p class="text-paper-deep text-[13px] leading-[1.8] flex-1">台北市區當日配送真的救了我一命，花束狀態完美。</p>
          <p class="font-mono-ledger text-paper text-xs">— 陳阿明</p>
        </div>
        <div class="border border-paper-deep/40 p-7 flex flex-col gap-4">
          <div class="text-gold-thread text-sm">★★★★★</div>
          <p class="text-paper-deep text-[13px] leading-[1.8] flex-1">收到花束的瞬間能感受到那份溫暖與心意，會繼續支持。</p>
          <p class="font-mono-ledger text-paper text-xs">— 大衛</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="-mx-4 bg-paper-deep flex flex-col items-center gap-5 text-center px-6 md:px-16 py-16">
    <h2 class="font-serif-tc text-[22px] font-bold text-ink">訂閱花訊，不錯過任何限定特惠</h2>
    <div class="flex items-stretch">
      <input
        type="email"
        placeholder="輸入您的電子郵件"
        class="border border-ink-soft bg-paper px-5 py-3 text-sm text-ink placeholder:text-ink-soft outline-none w-[260px] sm:w-[300px] border-r-0"
      />
      <button class="stamp-btn rounded-l-none">訂閱</button>
    </div>
  </section>

</div>
