<div id="app">
  <h1 class="font-serif-tc text-[32px] font-bold text-ink mb-8">我的訂單</h1>

  <div v-if="loading" class="flex justify-center py-16">
    <div class="w-8 h-8 border-4 border-moss border-t-transparent rounded-full animate-spin"></div>
  </div>

  <template v-if="!loading && orders.length === 0">
    <%- include('../partials/empty-state', { icon: '📦', title: '尚無訂單', description: '快去選購喜歡的花束吧！' }) %>
  </template>

  <div v-if="!loading && orders.length > 0" class="flex flex-col gap-3">
    <a
      v-for="order in orders"
      :key="order.id"
      :href="'/orders/' + order.id"
      class="bg-paper-deep p-5 flex flex-col md:flex-row justify-between items-center gap-3 order-card-hover transition-colors"
    >
      <div class="flex flex-col gap-1 w-full md:w-auto">
        <span class="font-mono-ledger text-ink text-[15px]">{{ order.order_no }}</span>
        <span class="text-ink-soft text-sm">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</span>
      </div>
      <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end">
        <span class="font-mono-ledger font-bold text-ink text-[17px]">NT$ {{ order.total_amount.toLocaleString() }}</span>
        <span
          class="status-stamp"
          :class="{
            'text-gold-thread': order.status === 'pending',
            'text-moss': order.status === 'paid',
            'text-stamp': order.status === 'failed'
          }"
        >
          {{ statusMap[order.status]?.label || order.status }}
        </span>
      </div>
    </a>
  </div>
</div>
