<div id="app" data-product-id="<%= productId %>">

  <div v-if="loading" class="flex justify-center py-20">
    <div class="w-8 h-8 border-4 border-moss border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="notFound" class="text-center py-20">
    <h2 class="font-serif-tc text-2xl font-bold text-ink mb-2">找不到此商品</h2>
    <p class="text-ink-soft mb-6">該商品可能已下架或不存在</p>
    <a href="/" class="stamp-btn">回到首頁</a>
  </div>

  <div v-else-if="product" class="py-10">
    <div class="flex flex-col lg:flex-row gap-14 items-start pb-16">

      <!-- Left: Image -->
      <div class="w-full lg:w-[480px] flex-shrink-0">
        <div class="w-full aspect-square bg-paper-deep border border-ink overflow-hidden">
          <img
            :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=800'"
            :alt="product.name"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Right: Info -->
      <div class="flex-1 flex flex-col gap-4">
        <p class="font-mono-ledger text-[12px] tracking-wide text-ink-soft">{{ 'No.' + String(product.id).padStart(3, '0') + ' · 花藝系列' }}</p>
        <h1 class="font-serif-tc text-[32px] font-bold text-ink leading-tight">{{ product.name }}</h1>
        <p class="font-mono-ledger text-[26px] font-bold text-stamp">NT$ {{ product.price.toLocaleString() }}</p>
        <div>
          <span v-if="product.stock > 0" class="status-stamp text-moss">尚有 {{ product.stock }} 件</span>
          <span v-else class="status-stamp text-stamp">已售完</span>
        </div>

        <p class="text-ink-soft text-[14px] leading-[1.8] mt-1">{{ product.description }}</p>

        <!-- Quantity -->
        <div class="flex items-center gap-0 border border-ink-soft w-[120px] justify-between px-3.5 py-2 mt-2">
          <button
            @click="decrease"
            :disabled="quantity <= 1"
            class="font-mono-ledger text-lg text-ink disabled:opacity-30"
          >–</button>
          <span class="font-mono-ledger text-base text-ink">{{ quantity }}</span>
          <button
            @click="increase"
            :disabled="quantity >= product.stock"
            class="font-mono-ledger text-lg text-ink disabled:opacity-30"
          >+</button>
        </div>

        <button
          @click="addToCart"
          :disabled="adding || product.stock <= 0"
          class="stamp-btn w-full mt-2"
        >
          {{ product.stock <= 0 ? '已售完' : (adding ? '加入中...' : '加入購物車') }}
        </button>

        <!-- Purchase Notes -->
        <div class="bg-paper-deep p-5 flex flex-col gap-2 mt-3">
          <p class="text-ink-soft text-[12px]">· 花材依季節略有差異，以實際到貨為準</p>
          <p class="text-ink-soft text-[12px]">· 台北市區當日配送，其他地區 1-3 個工作天</p>
          <p class="text-ink-soft text-[12px]">· 消費滿 NT$500 免運</p>
        </div>
      </div>
    </div>
  </div>
</div>
