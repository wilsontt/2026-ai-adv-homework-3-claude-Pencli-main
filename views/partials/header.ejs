    <!-- Right -->
    <div class="flex items-center gap-6">
      <div id="auth-nav" class="flex items-center gap-5 text-[14px] text-floral-text-secondary">
        <a href="/login" class="hover:text-floral-green transition-colors">登入</a>
      </div>
      <a href="/cart" class="relative flex items-center gap-1.5 bg-floral-green text-white px-4 py-2 rounded text-[13px] font-medium hover:bg-floral-green-mid transition-colors">
        <span class="material-symbols-outlined text-[16px] leading-none">shopping_bag</span>
        <span>購物車</span>
        <span
          id="cart-badge"
          class="hidden absolute -top-1.5 -right-1.5 bg-floral-gold text-white text-[10px] font-bold h-4 w-4 rounded-full items-center justify-center"
        ></span>
      </a>
    </div>

  </div>
</header>
