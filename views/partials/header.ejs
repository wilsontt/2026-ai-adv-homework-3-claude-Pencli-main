<header class="sticky top-0 w-full z-50 bg-white border-b border-floral-border">
  <div class="flex justify-between items-center h-[72px] px-6 md:px-16 max-w-[1440px] mx-auto">

    <!-- Logo -->
    <a href="/" class="flex flex-col leading-none gap-0.5">
      <span class="text-[9px] font-medium text-floral-text-muted tracking-[2.5px] uppercase">FLORAL STUDIO</span>
      <span class="text-[22px] font-bold text-floral-green font-display leading-none">花漾生活</span>
    </a>

    <!-- Nav -->
    <nav class="hidden md:flex items-center gap-10 text-[14px] text-floral-text-secondary">
      <a href="/" class="hover:text-floral-green transition-colors">首頁</a>
      <a id="orders-link" href="/orders" class="hover:text-floral-green transition-colors hidden">我的訂單</a>
